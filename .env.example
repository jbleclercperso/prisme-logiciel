# Copiez ce fichier en ".env" puis remplissez.
# Rien a remplir pour Claude : Jarvis utilise votre forfait (Connexion-Claude.bat).
# ANTHROPIC_API_KEY ne sert que si vous choisissez "fournisseur: api" dans config.yaml.
ANTHROPIC_API_KEY=

# E-mail (optionnel). Pour Gmail : creez un "mot de passe d'application"
# sur https://myaccount.google.com/apppasswords (validation en 2 etapes requise).
JARVIS_EMAIL_ADDRESS=
JARVIS_EMAIL_PASSWORD=
JARVIS_SMTP_HOST=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_IMAP_HOST=imap.gmail.com
